# knockout (public site) — environment template
#
# Copy to .env.local and adjust. .env.local is git-ignored.
# NEXT_PUBLIC_* values are inlined into the browser bundle: never put a secret
# behind that prefix.

# Where the dashboard (salo-run) runs; used for post-login hand-off.
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001

# Browser API calls go to this app's OWN same-origin proxy (/api/proxy). The
# proxy strips Domain=.connekyt.com from Set-Cookie on localhost so the auth
# cookie works across :3000 and :3001. Do not point this straight at the
# backend in local dev, or cross-port login breaks.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/proxy

# Server-side only (no NEXT_PUBLIC_ prefix): what the proxy forwards to.
# Live data: https://backend.connekyt.com   Local backend: http://localhost:8080
BACKEND_API_URL=https://backend.connekyt.com

# Google sign-in web client ID (Google Cloud Console). Public identifier, but
# each environment sets its own. Empty hides the Google buttons.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Sign in with Apple Services ID (Apple Developer portal > Identifiers >
# Services IDs). Empty keeps the Apple button visible but shows a
# "not set up" notice on click. Apple rejects localhost return URLs, so the
# popup only completes on a public HTTPS host that is registered on the ID.
NEXT_PUBLIC_APPLE_CLIENT_ID=com.connekyt.web

# Canonical/OG base URL for SEO tags. Set to the real public origin in every
# deployed environment, otherwise staging emits production SEO tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Verbose API request/response logging. Must be exactly "true" to enable.
NEXT_PUBLIC_DEBUG_API=false
